<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Bauducco Transportes — Central de Monitoramento</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --background: #f8fafc;
      --card: #ffffff;
      --primary: #e11d48;
      --primary-hover: #be123c;
      --text: #0f172a;
      --text-muted: #64748b;
      --border: #e2e8f0;
      --success: #16a34a;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: var(--background);
      color: var(--text);
      padding: 16px;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .app-container {
      width: 100%;
      max-width: 480px;
      background: var(--card);
      border-radius: 16px;
      padding: 24px;
      box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.05);
      border: 1px solid var(--border);
    }
    .header { text-align: center; margin-bottom: 20px; }
    .header h2 { font-size: 20px; color: var(--primary); font-weight: 700; }
    .header p { font-size: 13px; color: var(--text-muted); margin-top: 4px; }
    
    .status-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
      background: #ef4444;
      color: white;
      margin-bottom: 16px;
    }
    .status-badge.active { background: var(--success); }

    .form-group { margin-bottom: 14px; }
    .form-group label { display: block; font-size: 12px; font-weight: 600; margin-bottom: 4px; }
    .form-control {
      width: 100%; padding: 12px; border-radius: 8px; border: 1px solid var(--border);
      font-size: 14px; font-family: inherit; outline: none; background-color: #f8fafc;
    }
    .form-control:focus { border-color: var(--primary); background-color: #fff; }
    .form-control:disabled { background-color: #e2e8f0; color: #64748b; font-weight: 500; }
    
    .btn-submit {
      width: 100%; background-color: var(--primary); color: white; border: none;
      padding: 14px; font-size: 15px; font-weight: 600; border-radius: 8px;
      cursor: pointer; transition: background 0.2s; margin-top: 8px;
    }
    .btn-submit:hover { background-color: var(--primary-hover); }
    .btn-submit:disabled { background-color: var(--text-muted); }
    .photo-preview { margin-top: 8px; max-width: 100%; max-height: 120px; display: none; border-radius: 8px; }
  </style>
</head>
<body>

  <div class="app-container">
    <div class="header">
      <h2>Monitoramento de Viagem</h2>
      <p id="txtSubtitulo">Selecione sua placa para iniciar</p>
    </div>

    <div style="text-align: center;">
      <div id="badgeViagem" class="status-badge">Sem Viagem Aberta</div>
    </div>
    
    <form id="jornadaForm" onsubmit="registrarStatusJornada(event)">
      <div class="form-group">
        <label>Placa do Veículo</label>
        <select id="mPlaca" class="form-control" onchange="autocompletarDadosMotorista()" required>
          <option value="">-- Carregando placas... --</option>
        </select>
      </div>

      <div class="form-group">
        <label>Nome do Motorista</label>
        <input type="text" id="mNome" class="form-control" readonly placeholder="Selecione a placa acima...">
      </div>

      <div class="form-group">
        <label>Tipo de Veículo</label>
        <input type="text" id="mVeiculo" class="form-control" readonly placeholder="Preenchimento automático...">
      </div>

      <div class="form-group">
        <label>Telefone do Motorista</label>
        <input type="text" id="mTelefone" class="form-control" readonly placeholder="Preenchimento automático...">
      </div>

      <div class="form-group">
        <label>DT (Roteiro)</label>
        <input type="number" id="mDT" class="form-control" placeholder="Digite o número do roteiro DT" required>
      </div>

      <div class="form-group">
        <label>Nota Fiscal (NF)</label>
        <input type="text" id="mNF" class="form-control" placeholder="Número da Nota Fiscal" required>
      </div>

      <div class="form-group">
        <label>Tipo de Ocorrência / Status</label>
        <select id="mTipoOcorrencia" class="form-control" required>
          <option value="">-- Escolha o Status Atual --</option>
          <option value="Aguardando carregamento CD">Aguardando carregamento CD</option>
          <option value="Carregando">Carregando</option>
          <option value="Em trânsito">Em trânsito</option>
          <option value="Engarrafamento">Engarrafamento</option>
          <option value="Aguardando descarga no cliente">Aguardando descarga no cliente</option>
          <option value="Problema de nota fiscal (Trafego)">Problema de nota fiscal (Trafego)</option>
          <option value="Problema de sistema (GTE)">Problema de sistema (GTE)</option>
          <option value="Carga já entregue em outro dia">Carga já entregue em outro dia</option>
          <option value="Devolvido - Retornando CD">Devolvido - Retornando CD (Encerrar ID)</option>
          <option value="Entrega finalizada sem custo">Entrega finalizada sem custo (Encerrar ID)</option>
          <option value="Entrega finalizada com custo adicional">Entrega finalizada com custo adicional (Encerrar ID)</option>
        </select>
      </div>

      <div class="form-group">
        <label>Observação / Justificativa</label>
        <input type="text" id="mDescricao" class="form-control" placeholder="Descreva os detalhes da situação..." required>
      </div>

      <div class="form-group">
        <label>Foto Comprovante / Canhoto / Avaria</label>
        <input type="file" id="mFoto" class="form-control" accept="image/*" onchange="processarFoto(this)">
        <img id="imgPreview" class="photo-preview" src="#" alt="Preview">
      </div>

      <button type="submit" id="btnEnviar" class="btn-submit">Registrar Status</button>
    </form>
  </div>

  <script>
    // COLOQUE A SUA URL GERADA NO GOOGLE APPS SCRIPT ATUALIZADO AQUI
    const WEB_APP_URL = "https://script.google.com/macros/s/AKfycbxYPMnHRX1hZqJ0pC28qPVvpZ8AE7kan0qfW8G2ZWglQambF5iMuer1iwjmzM6rCHEw0g/exec";

    let listaMotoristasCadastrados = [];
    let fotoBase64 = null, fotoNome = "", fotoMime = "";

    window.addEventListener('DOMContentLoaded', async () => {
      await carregarListaPlacasDeCadastro();
      recuperarJornadaAtiva();
    });

    // Busca a lista de motoristas na aba CadastroMotoristas do Sheets
    async function carregarListaPlacasDeCadastro() {
      try {
        const response = await fetch(WEB_APP_URL);
        listaMotoristasCadastrados = await response.json();
        
        const selectPlaca = document.getElementById('mPlaca');
        selectPlaca.innerHTML = '<option value="">-- Escolha sua Placa --</option>';
        
        listaMotoristasCadastrados.forEach(m => {
          let opt = document.createElement('option');
          opt.value = m.placa;
          opt.textContent = m.placa + " (" + m.nome + ")";
          selectPlaca.appendChild(opt);
        });
      } catch (err) {
        document.getElementById('mPlaca').innerHTML = '<option value="">Erro ao carregar frota</option>';
      }
    }

    function autocompletarDadosMotorista() {
      const placaSelecionada = document.getElementById('mPlaca').value;
      const motorista = listaMotoristasCadastrados.find(m => m.placa === placaSelecionada);

      if (motorista) {
        document.getElementById('mNome').value = motorista.nome;
        document.getElementById('mVeiculo').value = motorista.veiculo;
        document.getElementById('mTelefone').value = motorista.telefone;
      } else {
        document.getElementById('mNome').value = "";
        document.getElementById('mVeiculo').value = "";
        document.getElementById('mTelefone').value = "";
      }
    }

    function processarFoto(input) {
      const preview = document.getElementById('imgPreview');
      if (input.files && input.files[0]) {
        const reader = new FileReader();
        fotoNome = input.files[0].name;
        fotoMime = input.files[0].type;
        reader.onload = function(e) {
          preview.src = e.target.result;
          preview.style.display = 'block';
          fotoBase64 = e.target.result;
        }
        reader.readAsDataURL(input.files[0]);
      }
    }

    function recuperarJornadaAtiva() {
      let idSalva = localStorage.getItem('idViagemBauducco');
      if(idSalva) {
        document.getElementById('badgeViagem').innerText = "ID Viagem Ativa: " + idSalva;
        document.getElementById('badgeViagem').classList.add('active');
        document.getElementById('mPlaca').value = localStorage.getItem('placaBauducco');
        autocompletarDadosMotorista();
        document.getElementById('mDT').value = localStorage.getItem('dtBauducco');
        document.getElementById('mNF').value = localStorage.getItem('nfBauducco');
        
        // Trava os dados essenciais para manter a integridade da ID
        document.getElementById('mPlaca').disabled = true;
        document.getElementById('mDT').disabled = true;
        document.getElementById('mNF').disabled = true;
        document.getElementById('txtSubtitulo').innerText = "Atualizando dados para o ID " + idSalva;
      }
    }

    async function registrarStatusJornada(event) {
      event.preventDefault();
      const btn = document.getElementById('btnEnviar');
      const status = document.getElementById('mTipoOcorrencia').value;
      
      btn.disabled = true;
      btn.innerText = "Enviando para o Sheets...";

      let idViagem = localStorage.getItem('idViagemBauducco');
      if (!idViagem) {
        // Se for o primeiro status, gera uma ID aleatória de 4 dígitos
        idViagem = "BD-" + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('idViagemBauducco', idViagem);
        localStorage.setItem('placaBauducco', document.getElementById('mPlaca').value);
        localStorage.setItem('dtBauducco', document.getElementById('mDT').value);
        localStorage.setItem('nfBauducco', document.getElementById('mNF').value);
      }

      const payload = {
        idViagem: idViagem,
        placa: localStorage.getItem('placaBauducco') || document.getElementById('mPlaca').value,
        motorista: document.getElementById('mNome').value,
        tipoVeiculo: document.getElementById('mVeiculo').value,
        telefone: document.getElementById('mTelefone').value,
        dtRoteiro: localStorage.getItem('dtBauducco') || document.getElementById('mDT').value,
        notaFiscal: localStorage.getItem('nfBauducco') || document.getElementById('mNF').value,
        tipoOcorrencia: status,
        descricao: document.getElementById('mDescricao').value,
        fotoData: fotoBase64,
        fotoNome: fotoNome,
        fotoMime: fotoMime
      };

      try {
        await fetch(WEB_APP_URL, {
          method: "POST",
          mode: "no-cors",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });

        alert("Status '" + status + "' adicionado com sucesso!");

        // Regra de Encerramento: se escolher um status finalizador, limpa a ID e destrava o celular
        if(status.includes("Encerrar ID")) {
          localStorage.clear();
          document.getElementById('jornadaForm').reset();
          document.getElementById('mPlaca').disabled = false;
          document.getElementById('mDT').disabled = false;
          document.getElementById('mNF').disabled = false;
          document.getElementById('badgeViagem').innerText = "Sem Viagem Aberta";
          document.getElementById('badgeViagem').classList.remove('active');
          document.getElementById('txtSubtitulo').innerText = "Selecione sua placa para iniciar";
        } else {
          recuperarJornadaAtiva();
        }

        document.getElementById('mDescricao').value = "";
        document.getElementById('mFoto').value = "";
        document.getElementById('imgPreview').style.display = 'none';
        fotoBase64 = null;

      } catch (err) {
        alert("Erro de comunicação ao enviar.");
      } finally {
        btn.disabled = false;
        btn.innerText = "Registrar Status";
      }
    }
  </script>
</body>
</html>
